CREATE CONSTRAINT metric_id IF NOT EXISTS FOR (m:Metric) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT dash_id IF NOT EXISTS FOR (d:Dashboard) REQUIRE d.id IS UNIQUE;
CREATE CONSTRAINT report_id IF NOT EXISTS FOR (r:Report) REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT dp_id IF NOT EXISTS FOR (p:DataProduct) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT src_id IF NOT EXISTS FOR (s:SourceSystem) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT model_id IF NOT EXISTS FOR (m:Model) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT rec_id IF NOT EXISTS FOR (r:Recommendation) REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT team_id IF NOT EXISTS FOR (t:Team) REQUIRE t.id IS UNIQUE;
CREATE CONSTRAINT term_id IF NOT EXISTS FOR (g:GlossaryTerm) REQUIRE g.id IS UNIQUE;
CREATE INDEX metric_canon IF NOT EXISTS FOR (m:Metric) ON (m.workspace_id, m.name);
CREATE FULLTEXT INDEX metric_search IF NOT EXISTS FOR (m:Metric) ON EACH [m.name];
