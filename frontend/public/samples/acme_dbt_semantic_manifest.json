{
 "semantic_models": [
  {
   "name": "revenue",
   "description": "",
   "model": "ref('fct_revenue')",
   "node_relation": {
    "alias": "fct_revenue",
    "schema_name": "analytics",
    "database": "acme",
    "relation_name": "acme.analytics.fct_revenue"
   },
   "defaults": {
    "agg_time_dimension": "invoice_date"
   },
   "entities": [
    {
     "name": "revenue_line",
     "type": "primary",
     "expr": "line_id"
    }
   ],
   "measures": [
    {
     "name": "invoice_amount",
     "agg": "sum",
     "expr": "invoice_amount",
     "description": "Invoiced amount"
    },
    {
     "name": "returns",
     "agg": "sum",
     "expr": "returns",
     "description": "Credit notes for returns"
    },
    {
     "name": "discounts",
     "agg": "sum",
     "expr": "discounts",
     "description": "On- and off-invoice discounts"
    },
    {
     "name": "rebates",
     "agg": "sum",
     "expr": "rebates",
     "description": "Distributor rebates"
    }
   ],
   "dimensions": [
    {
     "name": "invoice_date",
     "type": "time",
     "type_params": {
      "time_granularity": "day"
     }
    },
    {
     "name": "region",
     "type": "categorical"
    },
    {
     "name": "channel",
     "type": "categorical"
    }
   ]
  },
  {
   "name": "ecom_orders",
   "description": "",
   "model": "ref('fct_ecom_orders')",
   "node_relation": {
    "alias": "fct_ecom_orders",
    "schema_name": "analytics",
    "database": "acme",
    "relation_name": "acme.analytics.fct_ecom_orders"
   },
   "defaults": {
    "agg_time_dimension": "order_date"
   },
   "entities": [
    {
     "name": "ecom_orders_line",
     "type": "primary",
     "expr": "line_id"
    }
   ],
   "measures": [
    {
     "name": "order_value",
     "agg": "sum",
     "expr": "order_value",
     "description": "Gross order value"
    },
    {
     "name": "refunds",
     "agg": "sum",
     "expr": "refunds",
     "description": "Refunds"
    },
    {
     "name": "orders",
     "agg": "count_distinct",
     "expr": "order_id",
     "description": "Distinct orders"
    }
   ],
   "dimensions": [
    {
     "name": "order_date",
     "type": "time",
     "type_params": {
      "time_granularity": "day"
     }
    },
    {
     "name": "region",
     "type": "categorical"
    }
   ]
  }
 ],
